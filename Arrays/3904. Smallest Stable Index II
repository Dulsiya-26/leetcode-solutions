class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int n=nums.length;
        int[] arr=new int[n];
        arr[n-1]=nums[n-1];
        for(int i=n-2;i>=0;i--){
            arr[i]=Math.min(nums[i],arr[i+1]);
        }
        int[] res=new int[n];
        res[0]=nums[0];
        for(int i=1;i<n;i++){
          res[i]=Math.max(res[i-1],nums[i]);
        }
        for(int i=0;i<n;i++){
            if(res[i]-arr[i]<=k){
                return i;
            }
        }
        return -1;
    }
}