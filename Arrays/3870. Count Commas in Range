class Solution {
    public int countCommas(int n) {
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=i+1;
        }
        int cnt=0;
        for(int i=0;i<n;i++){
            int k=arr[i];
            int copy=k;
            int len=0;
            while(copy!=0){
             len++;
             copy/=10;
            }
            int d=(len-1)/3;
            cnt+=d;
        }
        return cnt;
    }
}